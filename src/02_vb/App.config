<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Korijen CAD-a. Relativna putanja racuna se od mape u kojoj je .exe
         (predaja: ..\03_CATIA_model). Dokument se trazi u podmapi (00_main, 01_table, 04_fasteners...),
         a ako je nema - izravno u korijenu (ravna mapa iz CATIA Send To > Directory). -->
    <!-- Razvojno stablo: exe je u src\02_vb\build, CAD u src\01_cad. -->
    <add key="CadRoot" value="..\..\01_cad" />
    <!-- Ako su prazni, izvode se iz CadRoot. -->
    <add key="MasterPartPath" value="" />
    <add key="TableAssemblyPath" value="" />
    <!-- Sklop robota (mehanizam + alat). Otvara se tek kad zatreba.
         Ako je prazno: CadRoot\05_robot\robot_mainAssembly.CATProduct - NE 00_main,
         ondje su master i glavni sklop. -->
    <add key="RobotAssemblyPath" value="" />
    <!-- Glavni sklop: stol + robot. Ako je prazno, izvodi se iz CadRoot. -->
    <add key="MainAssemblyPath" value="" />
    <!-- Otvori i aktiviraj sklop stola pri spajanju (true/false). -->
    <add key="OpenTableAssembly" value="true" />
    <!-- Otvori main_assembly i njega updataj + prikazi nakon Apply (true/false).
         Bez toga se robot ne vidi kako se pomice - stol sam ga ne sadrzi. -->
    <add key="OpenMainAssembly" value="true" />
    <!-- Nominalne duljine segmenata iz RoboDK-a (Fanuc LR Mate 200iC).
         Slider dopusta nominal .. nominal + 20 % (zadatak, t. 3.2). -->
    <add key="NominalLenJ2J3" value="300" />
    <add key="NominalLenJ3J5" value="320" />
    <!-- Koliko tijelo baze robota strsi preko vanjskih provrta (po strani).
         Default = Fanuc LR Mate 200iC: baza ~190x150 na rasteru 100x60.
         Samo za limite u aplikaciji - taj parametar ne postoji u masteru.
         Vrijednost se moze mijenjati i u samom prozoru. -->
    <add key="RobotBaseOverhang" value="45" />
    <!-- Skica provrta baze je popravljena 15.08.2026. (prije je trosila axisOffsetX/Y
         zakrenuto za 90 st.). Postavi na false ako raster ikad opet legne bokom - tada
         app drzi minimume sigurnima za obje osi i upozorava. -->
    <add key="RobotMountSketchFixed" value="true" />
  </appSettings>
</configuration>
